---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Tailwind & Alpine -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" is:inline></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" is:inline></script>
    <script src="/tailwind-config.js" is:inline></script>
    <style is:global>
        body {
            background-color: #F5F5F4;
            color: #1C1917;
            background-image: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.15) 0%, transparent 50%), 
                              radial-gradient(circle at 100% 50%, rgba(249, 115, 22, 0.12) 0%, transparent 40%);
            background-attachment: fixed;
        }
        /* Motif & Animations from source HTML... */
        .motif-wordmark { position: fixed; font-size: 28vw; font-weight: 700; color: rgba(28, 25, 23, 0.04); z-index: 0; pointer-events: none; top: 50%; left: 50%; transform: translate(-50%, -50%); }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body x-data="clubsApp()" x-init="initApp()" @keydown.window="handleKeydown($event)" class="bg-surface text-on-surface antialiased min-h-screen relative overflow-x-hidden font-body-md text-body-md">
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 flex items-center justify-center">
        <div class="motif-wordmark">CLUBS</div>
    </div>
    <slot />
    
    <script is:inline>
        // Alpine.js Logic from original source
        function clubsApp() {
            return {
                isAdmin: false,
                clickCount: 0,
                toast: { show: false, message: '' },
                clicks: {},
                clubs: [
                    { id: 'ent', name: 'Entrepreneurs', category: 'Business', icon: 'lightbulb', description: 'Startup incubators...' },
                    // ... other clubs
                ],
                initApp() { /* logic */ },
                handleLogoClick() { /* logic */ },
                enableAdminMode() { /* logic */ },
                trackClick(clubId) { /* logic */ }
            }
        }
    </script>
</body>
</html>
