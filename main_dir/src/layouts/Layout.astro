---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = "St Aloysius Clubs Portal" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <!-- Cleanly disables annoying auto-zoom on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script is:inline id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "surface": "#F5F5F4", "on-surface": "#1c1917", "primary": "#f97316", 
                        "outline-variant": "#d6d3d1", "on-surface-variant": "#57534e", "inverse-surface": "#292524"
                    },
                    spacing: { "margin_mobile": "24px", "gutter": "48px", "container_max_width": "1280px", "stack_md": "32px", "stack_lg": "64px", "section_gap": "120px" },
                    fontFamily: {
                        "display-lg": ["Geist", "sans-serif"],
                        "headline-md": ["Geist", "sans-serif"],
                        "body-lg": ["Geist", "sans-serif"],
                        "body-md": ["Geist", "sans-serif"],
                        "meta-label": ["JetBrains Mono", "monospace"],
                        "status-code": ["JetBrains Mono", "monospace"]
                    }
                }
            }
        }
    </script>

    <style is:global>

        body {
        background-color: #F5F5F4;
        color: #1C1917;
        /* Enhanced vibrant multi-light setup */
        background-image: 
            /* Top center - vibrant blue/cyan */
            radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.35) 0%, transparent 60%), 
            /* Top right - vibrant orange */
            radial-gradient(circle at 100% 20%, rgba(249, 115, 22, 0.30) 0%, transparent 55%),
            /* Bottom left - rich purple */
            radial-gradient(circle at 0% 80%, rgba(168, 85, 247, 0.30) 0%, transparent 60%),
            /* Top left - bright teal */
            radial-gradient(circle at 5% 15%, rgba(45, 212, 191, 0.25) 0%, transparent 50%),
            /* Bottom right - hot pink */
            radial-gradient(circle at 95% 90%, rgba(244, 63, 94, 0.25) 0%, transparent 55%),
            /* Center offset - subtle amber/yellow glow to tie it together */
            radial-gradient(circle at 60% 50%, rgba(250, 204, 21, 0.15) 0%, transparent 45%);
        background-attachment: fixed;
        /* Prevents double-tap to zoom on touch devices */
        touch-action: manipulation; 
    }
        .motif-wordmark {
            position: fixed; font-size: 28vw; font-weight: 700; color: rgba(28, 25, 23, 0.04);
            z-index: 0; pointer-events: none; white-space: nowrap; top: 50%; left: 50%;
            transform: translate(-50%, -50%); font-family: 'Geist', sans-serif;
            mix-blend-mode: multiply; 
        }
        .diffusion-shadow {
            box-shadow: 0 20px 40px -10px rgba(28, 25, 23, 0.05), 0 10px 20px -5px rgba(28, 25, 23, 0.02);
        }
        .diffusion-shadow-hover:hover {
            transform: translateY(-4px); box-shadow: 0 30px 60px -15px rgba(28, 25, 23, 0.08);
        }
        @keyframes fade-up { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-up { animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        
        @keyframes drift { 0% { transform: translate(0, 0); } 50% { transform: translate(15px, -20px); } 100% { transform: translate(0, 0); } }
        .animate-drift { animation: drift 12s ease-in-out infinite; }
        .animate-drift-slow { animation: drift 18s ease-in-out infinite reverse; }

        [x-cloak] { display: none !important; }
        
        /* Mobile text size adjustments */
        @media (max-width: 768px) {
            input, textarea, select { font-size: 16px !important; } /* Stops iOS Safari zoom on focus */
        }
    </style>
</head>
<body x-data="clubsApp()" x-init="initApp()" @keydown.window="handleKeydown($event)" class="bg-surface text-on-surface antialiased min-h-screen relative overflow-x-hidden selection:bg-primary selection:text-white font-body-md text-body-md flex flex-col">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 flex items-center justify-center">
        <div class="motif-wordmark">CLUBS</div>
    </div>

    <Navbar />

    <!-- Page Content gets injected here -->
    <slot /> 

    <Footer />

    <!-- Global Toast Notification -->
    <div x-cloak x-show="toast.show" class="fixed bottom-10 right-10 z-[110]">
        <div class="bg-on-surface text-surface px-6 py-4 font-meta-label text-xs tracking-widest uppercase flex items-center gap-3 diffusion-shadow">
            <span class="material-symbols-outlined font-light text-[18px]">check</span>
            <span x-text="toast.message"></span>
        </div>
    </div>

    <script is:inline>
        function clubsApp() {
            return {
                isAdmin: false,
                clickCount: 0,
                clickTimer: null,
                showAddClubModal: false,
                toast: { show: false, message: '' },
                clicks: {},
                clubs: window.initialClubsData || [], 
                
                initApp() {
                    if (window.location.hash === '#admin') this.enableAdminMode();
                    
                    const storedClicks = localStorage.getItem('aloysius_club_clicks');
                    if (storedClicks) {
                        try { this.clicks = JSON.parse(storedClicks); } catch(e) { this.clicks = {}; }
                    } else {
                        this.clubs.forEach(c => this.clicks[c.id] = 0);
                    }
                },
                
                handleLogoClick() {
                    this.clickCount++;
                    if (this.clickCount === 1) {
                        this.clickTimer = setTimeout(() => { this.clickCount = 0; }, 2500);
                    }
                    if (this.clickCount >= 5) {
                        clearTimeout(this.clickTimer); this.clickCount = 0; this.enableAdminMode();
                    }
                },
                
                handleKeydown(e) {
                    if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'a') {
                        e.preventDefault(); this.enableAdminMode();
                    }
                },
                
                enableAdminMode() {
                    if (!this.isAdmin) {
                        this.isAdmin = true;
                        window.location.hash = 'admin';
                        this.toast.message = 'Admin Access Granted';
                        this.toast.show = true;
                        setTimeout(() => { this.toast.show = false; }, 3000);
                    }
                },
                
                visitClub(clubId, link) {
                    if (!this.clicks[clubId]) this.clicks[clubId] = 0;
                    this.clicks[clubId]++;
                    localStorage.setItem('aloysius_club_clicks', JSON.stringify(this.clicks));
                    
                    this.toast.message = 'Visit Logged... Redirecting';
                    this.toast.show = true;
                    
                    if (link && link !== 'undefined' && link !== '#') {
                        setTimeout(() => { window.location.href = link; }, 400);
                    } else {
                        setTimeout(() => { this.toast.show = false; }, 2000);
                    }
                },
                
                getTotalClicks() {
                    return Object.values(this.clicks).reduce((a, b) => a + (b || 0), 0) || 0;
                }
            }
        }
    </script>
</body>
</html>
