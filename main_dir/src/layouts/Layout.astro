---
// src/layouts/Layout.astro
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "A directory of student clubs at St Aloysius (Deemed to be University), Mangalore" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet" />
    <style is:global>
      @import "tailwindcss";
      @import "tw-animate-css";

      @custom-variant dark (&:is(.dark *));

      :root {
        /* Claude-inspired palette */
        --coral: #cc785c;
        --coral-active: #a9583e;
        --coral-disabled: #e6dfd8;
        --ink: #141413;
        --body: #3d3d3a;
        --body-strong: #252523;
        --muted: #6c6a64;
        --muted-soft: #8e8b82;
        --hairline: #e6dfd8;
        --hairline-soft: #ebe6df;
        --canvas: #faf9f5;
        --surface-soft: #f5f0e8;
        --surface-card: #efe9de;
        --surface-cream-strong: #e8e0d2;
        --surface-dark: #181715;
        --surface-dark-elevated: #252320;
        --surface-dark-soft: #1f1e1b;
        --on-primary: #ffffff;
        --on-dark: #faf9f5;
        --on-dark-soft: #a09d96;
        --accent-teal: #5db8a6;
        --accent-amber: #e8a55a;
        --success: #5db872;
        --warning: #d4a017;
        --error: #c64545;

        /* Legacy tokens mapped to new palette */
        --maroon: var(--coral);
        --gold: var(--accent-amber);
        --warm-surface: var(--surface-card);
        --line: var(--hairline);

        --font-heading: 'Lora', Georgia, 'Times New Roman', serif;
        --font-body: 'DM Sans', 'Segoe UI', Roboto, sans-serif;
        --radius: 0.75rem;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;
        min-height: 100dvh;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.7;
      }

      button, a {
        -webkit-tap-highlight-color: transparent;
        transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
      }

      button:focus-visible, a:focus-visible {
        outline: 3px solid var(--coral);
        outline-offset: 4px;
      }

      .site-shell {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
      }

      /* ============================================================
         SITE HEADER — Cream nav with hairline border
         ============================================================ */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid var(--hairline);
        background: color-mix(in srgb, var(--canvas) 94%, transparent);
        backdrop-filter: blur(16px);
      }

      .header-inner {
        width: min(100% - 2rem, 1180px);
        min-height: 76px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand-link {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--ink);
        text-decoration: none;
      }

      .brand-link:hover {
        color: var(--coral);
      }

      .crest-placeholder {
        width: 39px;
        height: 45px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        color: var(--on-primary);
        background: var(--coral);
        border: 2px solid var(--canvas);
        border-radius: 48% 48% 45% 45% / 36% 36% 57% 57%;
        box-shadow: 0 4px 10px rgba(204, 120, 92, 0.15);
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
      }

      .brand-copy {
        display: grid;
        line-height: 1.1;
      }

      .brand-name {
        font-family: var(--font-heading);
        font-size: clamp(1rem, 2.4vw, 1.2rem);
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .brand-university {
        margin-top: 0.28rem;
        color: var(--muted);
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .desktop-nav {
        display: none;
        align-items: center;
        gap: 0.2rem;
      }

      .nav-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.75rem;
        border-bottom: 2px solid transparent;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        font-family: var(--font-body);
      }

      .nav-link:hover,
      .nav-link[aria-current="page"] {
        border-bottom-color: var(--accent-amber);
        color: var(--coral);
      }

      .nav-link--muted {
        cursor: default;
        opacity: 0.7;
      }

      .nav-link--muted:hover {
        border-bottom-color: transparent;
        color: var(--muted);
      }

      .menu-toggle {
        width: 46px;
        height: 46px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--hairline);
        border-radius: 0.7rem;
        color: var(--coral);
        background: var(--canvas);
        cursor: pointer;
      }

      .menu-toggle:hover {
        border-color: var(--accent-amber);
        background: var(--surface-card);
      }

      .mobile-menu {
        width: min(100% - 2rem, 1180px);
        margin-inline: auto;
        padding: 0 0 1rem;
        display: grid;
        gap: 0.25rem;
      }

      .mobile-menu .nav-link {
        min-height: 48px;
        padding-inline: 0.9rem;
        border: 0;
        border-radius: 0.65rem;
      }

      .mobile-menu .nav-link:hover,
      .mobile-menu .nav-link[aria-current="page"] {
        background: var(--surface-card);
      }

      @media (min-width: 1025px) {
        .desktop-nav {
          display: flex;
        }
        .menu-toggle,
        .mobile-menu {
          display: none;
        }
      }

      /* ============================================================
         HERO — Cream canvas, serif display, coral accents
         ============================================================ */
      .phase-preview {
        position: relative;
        isolation: isolate;
        flex: 1;
        display: flex;
        align-items: center;
        min-height: 480px;
        padding: 4.5rem 1rem 5.5rem;
        background: var(--canvas);
      }

      .phase-preview::before,
      .phase-preview::after {
        position: absolute;
        z-index: -1;
        display: block;
        border-radius: 999px;
        content: '';
        pointer-events: none;
      }

      .phase-preview::before {
        width: 170px;
        height: 170px;
        top: 7%;
        right: -80px;
        background: rgba(204, 120, 92, 0.10);
        transform: rotate(18deg);
      }

      .phase-preview::after {
        width: 130px;
        height: 130px;
        bottom: 11%;
        left: -72px;
        background: rgba(232, 165, 90, 0.10);
        transform: rotate(-24deg);
      }

      .preview-inner {
        width: min(100%, 860px);
        margin-inline: auto;
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 1.25rem;
        color: var(--coral);
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-family: var(--font-body);
      }

      .preview-title {
        max-width: 760px;
        margin: 0 auto;
        color: var(--ink);
        font-family: var(--font-heading);
        font-size: clamp(2.25rem, 8vw, 4.75rem);
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 1.08;
      }

      .preview-title em {
        color: var(--coral);
        font-style: normal;
        text-decoration: underline;
        text-decoration-color: var(--accent-amber);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.12em;
      }

      .preview-copy {
        max-width: 590px;
        margin: 1.5rem auto 0;
        color: var(--body);
        font-size: clamp(1rem, 2vw, 1.15rem);
        line-height: 1.75;
        font-family: var(--font-body);
      }

      .preview-rule {
        width: min(100%, 410px);
        height: 1px;
        margin: 2.5rem auto 0;
        background: linear-gradient(90deg, transparent, var(--accent-amber), transparent);
      }

      .preview-note {
        width: fit-content;
        max-width: 100%;
        margin: 2rem auto 0;
        padding: 0.8rem 1.1rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.42);
        font-size: 0.82rem;
        font-family: var(--font-body);
      }

      /* ============================================================
         ABOUT SECTION — Cream surface card
         ============================================================ */
      .about-preview {
        background: var(--surface-card);
        border-radius: 0.75rem;
        padding: 2rem 1.5rem !important;
        margin: 0 auto 3rem !important;
      }

      .about-preview h2 {
        color: var(--coral) !important;
      }

      .about-preview p {
        color: var(--body) !important;
      }

      .about-preview p strong {
        color: var(--coral);
      }

      /* ============================================================
         PAGE HEADER
         ============================================================ */
      .page-header {
        padding: 3rem 1rem 1.5rem;
        text-align: center;
        background: var(--canvas);
      }

      .page-title {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--ink);
        margin: 0;
        font-weight: 400;
        letter-spacing: -0.03em;
      }

      .page-description {
        color: var(--body);
        font-size: 1.1rem;
        margin-top: 0.5rem;
        font-family: var(--font-body);
      }

      /* ============================================================
         FILTERS SECTION — Cream background with coral active state
         ============================================================ */
      .filters-section {
        width: min(100% - 2rem, 1180px);
        margin-inline: auto;
        padding: 0 0 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: center;
        background: var(--canvas);
      }

      .search-box {
        flex: 1;
        min-width: 200px;
        max-width: 400px;
        padding: 0.75rem 1rem;
        border: 1px solid var(--hairline);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        background: var(--canvas);
        font-family: var(--font-body);
        transition: border-color 180ms ease;
        color: var(--ink);
      }

      .search-box:focus {
        outline: none;
        border-color: var(--coral);
      }

      .search-box::placeholder {
        color: var(--muted-soft);
      }

      .category-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .category-btn {
        padding: 0.5rem 1rem;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: var(--canvas);
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 180ms ease;
        font-family: var(--font-body);
      }

      .category-btn:hover {
        border-color: var(--accent-amber);
        color: var(--coral);
        background: var(--surface-soft);
      }

      .category-btn.active {
        border-color: var(--coral);
        background: var(--coral);
        color: var(--on-primary);
      }

      /* ============================================================
         CLUB GRID — Cards on cream canvas
         ============================================================ */
      .club-grid-section {
        width: min(100% - 2rem, 1180px);
        margin-inline: auto;
        padding: 1rem 0 3rem;
        background: var(--canvas);
      }

      .club-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .club-card {
        background: var(--canvas);
        border-radius: 0.75rem;
        padding: 1.5rem;
        border: 1px solid var(--hairline);
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: var(--ink);
        box-shadow: 0 2px 8px rgba(20, 20, 19, 0.04);
      }

      .club-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(20, 20, 19, 0.08);
        border-color: var(--accent-amber);
      }

      .club-card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
      }

      .club-logo {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: contain;
        background: var(--surface-card);
        flex-shrink: 0;
      }

      .club-card-info {
        flex: 1;
        min-width: 0;
      }

      .club-card-category {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--coral);
        font-weight: 600;
        font-family: var(--font-body);
      }

      .club-card-name {
        font-family: var(--font-heading);
        font-size: 1.1rem;
        margin: 0.1rem 0;
        color: var(--ink);
        font-weight: 500;
      }

      .club-card-tagline {
        font-size: 0.9rem;
        color: var(--muted);
        margin: 0;
        line-height: 1.4;
        font-family: var(--font-body);
      }

      .club-card-footer {
        margin-top: 1rem;
        display: flex;
        justify-content: flex-end;
      }

      .visit-btn {
        padding: 0.5rem 1.25rem;
        border-radius: 0.75rem;
        background: var(--coral);
        color: var(--on-primary);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 180ms ease;
        border: none;
        cursor: pointer;
        font-family: var(--font-body);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .visit-btn:hover {
        background: var(--coral-active);
      }

      .visit-btn.outline {
        background: transparent;
        border: 1px solid var(--coral);
        color: var(--coral);
      }

      .visit-btn.outline:hover {
        background: var(--coral);
        color: var(--on-primary);
      }

      @media (min-width: 640px) {
        .club-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .club-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      @media (min-width: 1280px) {
        .club-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      /* ============================================================
         CLUB DETAIL — Card on cream canvas
         ============================================================ */
      .club-detail {
        padding: 2rem 1rem 4rem;
        background: var(--canvas);
      }

      .club-detail-inner {
        width: min(100%, 820px);
        margin-inline: auto;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--muted);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: color 180ms ease;
        font-family: var(--font-body);
      }

      .back-link:hover {
        color: var(--coral);
      }

      .club-detail-card {
        background: var(--canvas);
        border-radius: 0.75rem;
        padding: 2rem;
        border: 1px solid var(--hairline);
        box-shadow: 0 2px 12px rgba(20, 20, 19, 0.06);
      }

      .club-detail-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }

      .club-logo-large {
        width: 120px;
        height: 120px;
        flex-shrink: 0;
        border-radius: 50%;
        overflow: hidden;
        background: var(--surface-card);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .club-logo-large img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .club-detail-info {
        flex: 1;
      }

      .club-category {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        background: var(--surface-card);
        color: var(--coral);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.5rem;
        font-family: var(--font-body);
      }

      .club-name {
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        color: var(--ink);
        margin: 0 0 0.25rem;
        font-weight: 400;
        letter-spacing: -0.03em;
      }

      .club-tagline {
        font-size: 1.1rem;
        color: var(--muted);
        margin: 0;
        font-family: var(--font-body);
      }

      .club-detail-body {
        border-top: 1px solid var(--hairline);
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .club-description h2,
      .club-coordinator h3 {
        font-family: var(--font-heading);
        color: var(--ink);
        font-weight: 400;
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
      }

      .club-description p {
        color: var(--body);
        line-height: 1.8;
        margin: 0;
        font-family: var(--font-body);
      }

      .club-coordinator p {
        color: var(--muted);
        margin: 0;
        font-family: var(--font-body);
      }

      .visit-website-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        background: var(--coral);
        color: var(--on-primary);
        text-decoration: none;
        font-weight: 600;
        width: fit-content;
        transition: background 180ms ease;
        font-family: var(--font-body);
      }

      .visit-website-btn:hover {
        background: var(--coral-active);
      }

      /* ============================================================
         ABOUT & CONTACT PAGES
         ============================================================ */
      .about-page,
      .contact-page {
        padding: 2rem 1rem 4rem;
        background: var(--canvas);
      }

      .about-inner,
      .contact-inner {
        width: min(100%, 820px);
        margin-inline: auto;
      }

      .about-section {
        margin-bottom: 2.5rem;
        background: var(--canvas);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--hairline);
      }

      .about-section h2 {
        font-family: var(--font-heading);
        color: var(--ink);
        font-weight: 400;
        letter-spacing: -0.02em;
        font-size: 1.5rem;
      }

      .about-section p {
        color: var(--body);
        line-height: 1.8;
        font-family: var(--font-body);
      }

      .about-section p em {
        color: var(--coral);
        font-style: italic;
      }

      .about-section p strong {
        color: var(--coral);
      }

      /* ============================================================
         CONTACT PAGE
         ============================================================ */
      .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-top: 1.5rem;
      }

      .contact-form-section,
      .contact-info-section {
        background: var(--canvas);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--hairline);
      }

      .contact-form-section h2,
      .contact-info-section h2 {
        font-family: var(--font-heading);
        color: var(--ink);
        font-weight: 400;
        letter-spacing: -0.02em;
        font-size: 1.3rem;
        margin: 0 0 1rem;
      }

      .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .form-group label {
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--ink);
        font-family: var(--font-body);
      }

      .form-group input,
      .form-group textarea {
        padding: 0.75rem 1rem;
        border: 1px solid var(--hairline);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        font-family: var(--font-body);
        transition: border-color 180ms ease;
        background: var(--canvas);
        color: var(--ink);
      }

      .form-group input:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: var(--coral);
      }

      .submit-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        background: var(--coral);
        color: var(--on-primary);
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: background 180ms ease;
        font-family: var(--font-body);
      }

      .submit-btn:hover {
        background: var(--coral-active);
      }

      .contact-address {
        font-style: normal;
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 1.5rem;
        font-family: var(--font-body);
      }

      .contact-address strong {
        color: var(--ink);
      }

      @media (min-width: 768px) {
        .contact-grid {
          grid-template-columns: 1.5fr 1fr;
        }
      }

      /* ============================================================
         SITE FOOTER — Dark navy surface
         ============================================================ */
      .site-footer {
        padding: 3rem 1rem 1.25rem;
        background: var(--surface-dark);
        color: var(--on-dark-soft);
        margin-top: auto;
        border-top: none;
      }

      .footer-inner {
        width: min(100%, 1180px);
        margin-inline: auto;
      }

      .footer-grid {
