---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="About - Aloysian Clubs Hub">
  <div class="site-shell">
    <SiteHeader />
    <main id="main-content" class="about-page">
      <div class="about-inner">
        <h1 class="page-title">About Aloysian Clubs Hub</h1>

        <section class="about-section">
          <h2>Our University</h2>
          <p>
            St Aloysius (Deemed to be University), Mangalore, is a Jesuit institution
            founded in 1880 with a rich tradition of academic excellence and holistic
            formation. The university motto, <em>"Lucet et Ardet"</em> — <strong>"Shine to Enkindle"</strong> —
            reflects the institution's commitment to nurturing students who illuminate
            the world through knowledge and ignite positive change through service.
          </p>
        </section>

        <section class="about-section">
          <h2>The Purpose of This Hub</h2>
          <p>
            Aloysian Clubs Hub is a central directory for all student clubs at
            St Aloysius University. Our goal is to help students discover communities
            that align with their interests, connect with fellow Aloysians, and
            participate in the vibrant extracurricular life of the university.
          </p>
          <p>
            Whether you're interested in cultural events, technical innovation,
            literary pursuits, sports, social service, or arts and media — there's
            a club for you. Explore, connect, and become part of the Aloysian spirit.
          </p>
        </section>
      </div>
    </main>
    <SiteFooter />
  </div>
</Layout>
