---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout title="Contact - Aloysian Clubs Hub">
  <div class="site-shell">
    <SiteHeader />
    <main id="main-content" class="contact-page">
      <div class="contact-inner">
        <h1 class="page-title">Contact Us</h1>

        <div class="contact-grid">
          <section class="contact-form-section">
            <h2>Send a Message</h2>
            <form class="contact-form" netlify>
              <input type="text" name="honeypot" style="display:none" />
              <div class="form-group">
                <label for="name">Your Name</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="5" required></textarea>
              </div>
              <button type="submit" class="submit-btn">Send Message</button>
            </form>
          </section>

          <aside class="contact-info-section">
            <h2>Visit Us</h2>
            <address class="contact-address">
              <strong>St Aloysius (Deemed to be University)</strong><br />
              St Aloysius College Road,<br />
              Kodialbail, Mangaluru – 575003,<br />
              Karnataka, India.
            </address>

            <div class="contact-map">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3888.920748233224!2d74.847132!3d12.903192!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba35a4d3e4f5e2b%3A0x8e5f4d3e4f5e2b1c!2sSt%20Aloysius%20College!5e0!3m2!1sen!2sin!4v1234567890"
                width="100%"
                height="250"
                style="border:0; border-radius: 8px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </aside>
        </div>
      </div>
    </main>
    <SiteFooter />
  </div>
</Layout>
