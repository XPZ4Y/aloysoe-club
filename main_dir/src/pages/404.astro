---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found - Aloysian Clubs Hub">
  <div class="site-shell">
    <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:4rem 1rem; text-align:center;">
      <div>
        <h1 style="font-family: var(--font-heading); font-size: 4rem; color: var(--maroon); margin:0 0 0.5rem;">404</h1>
        <p style="font-size:1.2rem; color: var(--muted); margin-bottom:1.5rem;">The page you're looking for doesn't exist.</p>
        <a href="/" class="visit-btn">Return Home</a>
      </div>
    </div>
  </div>
</Layout>
