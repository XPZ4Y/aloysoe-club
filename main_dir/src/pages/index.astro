---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClubCard from '../components/ClubCard.astro';
import { clubsData } from '../data/clubs.js';
---

<Layout title="St Aloysius Clubs Directory">
    
    <!-- Pass server-side Astro data to client-side JS window object -->
    <script define:vars={{ clubsData }}>
        window.initialClubsData = clubsData;
    </script>

    <main class="relative z-10 w-full flex flex-col items-center justify-start pb-section_gap flex-grow">
        <Hero />

        <!-- Directory Section -->
        <section id="directory-section" class="relative w-full max-w-container_max_width px-margin_mobile md:px-gutter py-24 mx-auto z-10">
            <div class="mb-20 border-b border-outline-variant/50 pb-8 flex justify-between items-end">
                <div>
                    <span class="font-meta-label text-meta-label text-primary uppercase tracking-widest mb-4 block">01 / Organizations</span>
                    <h2 class="font-display-lg text-5xl text-on-surface">Active Clubs</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
                {clubsData.map((club, index) => (
                    <ClubCard club={club} index={index} />
                ))}
            </div>
        </section>

        <!-- Analytics Section -->
        <section id="analytics-section" x-cloak x-show="isAdmin" class="relative w-full max-w-container_max_width px-margin_mobile md:px-gutter py-24 mx-auto z-10 bg-white/90 backdrop-blur-md border border-outline-variant/30 my-20 diffusion-shadow">
            <div class="p-12 border-b border-outline-variant/30">
                <span class="font-meta-label text-meta-label text-primary uppercase tracking-widest block mb-4">02 / Admin</span>
                <h2 class="font-display-lg text-5xl text-on-surface">Analytics</h2>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-3 gap-0 border-b border-outline-variant/30">
                <div class="p-12 border-r border-b md:border-b-0 border-outline-variant/30">
                    <span class="font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest block mb-4">Total Clicks</span>
                    <p x-text="getTotalClicks()" class="font-display-lg text-6xl text-on-surface"></p>
                </div>
                <div class="p-12 border-b md:border-b-0 md:border-r border-outline-variant/30">
                    <span class="font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest block mb-4">Active Clubs</span>
                    <p class="font-display-lg text-6xl text-on-surface">{clubsData.length}</p>
                </div>
                <div class="p-12 border-outline-variant/30">
                    <span class="font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest block mb-4">Top Club Traffic</span>
                    <p x-text="Math.max(...Object.values(clicks).length ? Object.values(clicks) : [0])" class="font-display-lg text-6xl text-primary"></p>
                </div>
            </div>

            <div class="w-full">
                <div class="p-8 border-b border-outline-variant/30 bg-surface/50 grid grid-cols-12 gap-6 font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest">
                    <div class="col-span-8 md:col-span-5">Organization</div>
                    <div class="col-span-4 md:col-span-2 text-right">Traffic</div>
                    <div class="col-span-5 hidden md:block">Volume</div>
                </div>
                
                <template x-for="club in [...clubs].sort((a,b) => (clicks[b.id]||0) - (clicks[a.id]||0))" :key="club.id">
                    <div class="p-8 border-b border-outline-variant/20 grid grid-cols-12 gap-6 items-center hover:bg-surface/30 transition-colors">
                        <div class="col-span-8 md:col-span-5 font-body-lg text-on-surface" x-text="club.name"></div>
                        <div class="col-span-4 md:col-span-2 text-right font-status-code text-on-surface" x-text="clicks[club.id] || 0"></div>
                        <div class="col-span-5 hidden md:flex items-center">
                            <div class="w-full h-1 bg-surface-variant overflow-hidden">
                                <div class="h-full bg-primary transition-all duration-1000 ease-out" 
                                     :style="`width: ${getTotalClicks() > 0 ? ((clicks[club.id]||0) / getTotalClicks() * 100) : 0}%`"></div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </section>
    </main>
</Layout>
