---
import Layout from '../layouts/Layout.astro';
import { clubs } from '../data/clubs.js';

const activityImage = '/clubs/entrepreneurs-event-06.jpg';

const categories = ['All', ...new Set(clubs.map((club) => club.category))];

function getContrastClass(name: string) {
  return name === 'Drama & Theatre Club' || name === 'Speakers Lounge' || name === 'SDG Club 2026' ? ' logo-dark-tile' : name === 'InSync' ? ' logo-light-tile' : '';
}

const icons = {
  ArrowDown: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>`,
  ArrowUpRight: `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>`,
  ArrowUpRightSmall: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>`,
  Check: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
  Search: `<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
};
---

<Layout title="St Aloysius | Clubs Directory">
  <div class="blueprint-app">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="#top" class="official-brand">
          <img src="/st-aloysius-official.png" alt="St Aloysius (Deemed to be University)" />
          <span>ST ALOYSIUS<br /><b>CLUBS DIRECTORY</b></span>
        </a>
        <button class="mobile-menu" aria-label="Open menu" id="mobile-menu-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="menu-icon"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
        <nav id="main-nav">
          <a class="active" href="#directory">Directory</a>
          <a href="#about">How it works</a>
          <a href="https://staloysius.edu.in/" target="_blank" rel="noreferrer">
            University <Fragment set:html={icons.ArrowUpRightSmall} />
          </a>
        </nav>
        <div class="top-actions">
          <span class="top-icon">◈</span>
          <span class="top-icon">◎</span>
          <a href="#directory" class="login-button">EXPLORE CLUBS</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="blueprint-hero page-width">
        <div class="campus-backdrop" aria-hidden="true">
          <img src="/st-aloysius-campus.jpg" alt="" />
        </div>
        <div class="hero-left">
          <div class="technical-path"><span>SCHOOL OF ENGINEERING</span><i>/</i><b>STUDENT LIFE</b></div>
          <h1>Find a <em>club</em> at<br />St Aloysius.</h1>
          <p>Explore student-led communities. Find a subject that interests you. Visit the club website for current details.</p>
          <div class="hero-actions">
            <a href="#directory" class="blue-button">SEE THE CLUBS <Fragment set:html={icons.ArrowUpRight} /></a>
            <a href="#about" class="under-link">WHY JOIN A CLUB <Fragment set:html={icons.ArrowDown} /></a>
          </div>
        </div>
        <div class="metric-card">
          <span class="node-id">NODE_00</span>
          <div class="metric-label">STUDENT CLUB DIRECTORY / 2026</div>
          <div class="metric-number">
            <strong>{clubs.length}</strong>
            <span>ACTIVE<br />STUDENT<br />CLUBS</span>
          </div>
          <ul>
            <li><b>01</b> LEARN A SKILL</li>
            <li><b>02</b> MEET STUDENTS</li>
            <li><b>03</b> WORK ON PROJECTS</li>
          </ul>
          <div class="metric-rule"></div>
        </div>
      </section>

      <div class="quick-links">
        <div class="quick-track">
          {clubs.slice(0, 6).map((club) => (
            <a href="#directory" key={club.name}>
              <div class={`logo-mark logo-mark-small${getContrastClass(club.name)}`} style={`--logo-accent: ${club.accent}`}>
                <img src={club.logo} alt={`${club.name} logo`} onerror="this.style.display='none'" />
                <span>{club.initials}</span>
              </div>
              <span>{club.name.toUpperCase()}</span>
              <Fragment set:html={icons.ArrowUpRightSmall} />
            </a>
          ))}
        </div>
      </div>

      <section class="practice page-width" id="about">
        <div class="practice-copy">
          <div class="section-tag"><b>01</b><span>WHY JOIN A CLUB</span></div>
          <h2>Build skills.<br /><em>Meet students.</em></h2>
          <p>Clubs are student-led groups. They help you build skills, confidence, friendships, and experience.</p>
          <p>Use this directory to compare communities. Each verified listing links to the club website for current information and joining instructions.</p>
        </div>
        <div class="practice-image">
          <img src={activityImage} alt="Students collaborating during a club activity" />
          <div class="image-caption">
            <span>STUDENT LIFE / IN PRACTICE</span>
            <strong>Learn by<br />working together.</strong>
          </div>
        </div>
      </section>

      <section class="directory-section" id="directory">
        <div class="page-width">
          <div class="directory-heading">
            <div>
              <div class="section-tag"><b>02</b><span>THE DIRECTORY</span></div>
              <h2>Find a <em>club.</em></h2>
            </div>
            <div class="directory-tools">
              <p>Search by name or subject. Select a category. Visit the club website for more information.</p>
              <label class="search-box">
                <Fragment set:html={icons.Search} />
                <input id="search-input" aria-label="Search clubs or subjects" placeholder="Search clubs or subjects" />
              </label>
            </div>
          </div>
          
          <div class="filter-row">
            {categories.map((item) => (
              <button 
                type="button" 
                class={item === 'All' ? 'filter-active' : ''} 
                data-category={item} 
                aria-pressed={item === 'All' ? 'true' : 'false'}
              >
                {item}
              </button>
            ))}
          </div>

          <div class="directory-grid" id="directory-grid">
            {clubs.map((club, index) => (
              <article 
                class="directory-card" 
                style={`--club-accent: ${club.accent}`} 
                data-category={club.category}
                data-search={`${club.name} ${club.category} ${club.tagline} ${club.note}`.toLowerCase()}
              >
                <span class="node-label">NODE_{String(index + 1).padStart(2, '0')}</span>
                <div class={`logo-mark${getContrastClass(club.name)}`} style={`--logo-accent: ${club.accent}`}>
                  <img src={club.logo} alt={`${club.name} logo`} onerror="this.style.display='none'" />
                  <span>{club.initials}</span>
                </div>
                <div class="card-category">{club.category}</div>
                <h3>{club.name}</h3>
                <p class="card-tagline">{club.tagline}</p>
                <p class="card-note">{club.note}</p>
                <div class="card-bottom">
                  <span class="card-status"><span></span>{club.destination}</span>
                  <a href={club.url} target="_blank" rel="noreferrer">
                    VISIT CLUB <Fragment set:html={icons.ArrowUpRight} />
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="empty-state" id="empty-state">
            <Fragment set:html={icons.Check} /> No clubs match. Try a different subject or category.
          </div>
        </div>
      </section>
    </main>

    <footer class="blueprint-footer">
      <div class="page-width footer-inner">
        <div class="footer-title">
          <img src="/st-aloysius-official.png" alt="St Aloysius" />
          <div class="footer-line"></div>
        </div>
        <div class="footer-columns">
          <div>
            <a href="#directory">Directory</a>
            <a href="#about">How it works</a>
            <a href="https://staloysius.edu.in/" target="_blank" rel="noreferrer">University website</a>
          </div>
          <div>
            <span class="footer-label">CAMPUS ADDRESS</span>
            <p>St Aloysius College Rd, Kodailbail<br />Mangaluru, Karnataka 575003</p>
          </div>
          <div>
            <span class="footer-label">DIRECTORY STATUS</span>
            <p class="footer-status"><span></span> ACTIVE · {clubs.length} CLUBS</p>
            <p>© 2026 St Aloysius School of Engineering.</p>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const filterButtons = document.querySelectorAll('.filter-row button');
      const cards = document.querySelectorAll('.directory-card');
      const emptyState = document.getElementById('empty-state');
      
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mainNav = document.getElementById('main-nav');
      const menuIcon = document.getElementById('menu-icon');

      let query = '';
      let category = 'All';

      // Filtering Logic
      function updateGrid() {
        let visibleCount = 0;
        
        filterButtons.forEach(btn => {
          if (btn.getAttribute('data-category') === category) {
            btn.classList.add('filter-active');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('filter-active');
            btn.setAttribute('aria-pressed', 'false');
          }
        });

        cards.forEach(card => {
          const el = card as HTMLElement;
          const searchStr = el.getAttribute('data-search') || '';
          const catStr = el.getAttribute('data-category') || '';
          
          const matchesQuery = query === '' || searchStr.includes(query.toLowerCase());
          const matchesCategory = category === 'All' || catStr === category;

          if (matchesQuery && matchesCategory) {
            el.style.display = 'flex';
            visibleCount++;
          } else {
            el.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          query = (e.target as HTMLInputElement).value;
          updateGrid();
        });
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          category = (e.currentTarget as HTMLElement).getAttribute('data-category') || 'All';
          updateGrid();
        });
      });

      // Mobile Menu Logic
      let menuOpen = false;
      if (mobileBtn && mainNav && menuIcon) {
        mobileBtn.addEventListener('click', () => {
          menuOpen = !menuOpen;
          if (menuOpen) {
            mainNav.classList.add('nav-open');
            mobileBtn.setAttribute('aria-label', 'Close menu');
            menuIcon.innerHTML = `<path d="M18 6 6 18M6 6l12 12"/>`;
          } else {
            mainNav.classList.remove('nav-open');
            mobileBtn.setAttribute('aria-label', 'Open menu');
            menuIcon.innerHTML = `<line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>`;
          }
        });
      }
    });
  </script>
</Layout>
