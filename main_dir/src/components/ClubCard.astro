---
const { club, index } = Astro.props;
---
<div class={`stagger-${(index % 2) + 1} stagger-lg-${(index % 3) + 1} bg-white/80 backdrop-blur-sm p-10 diffusion-shadow diffusion-shadow-hover transition-all duration-500 flex flex-col h-[420px] relative animate-fade-up opacity-0 border border-outline-variant/20`}
     style={`animation-delay: ${index * 150}ms; animation-fill-mode: forwards;`}>
    
    <!-- Alpine bindings mixed with Astro props -->
    <div x-cloak x-show={`isAdmin && clicks['${club.id}'] > 0`} class="absolute top-6 right-6">
        <span x-text={`clicks['${club.id}'] + ' CLICKS'`} class="font-meta-label text-[10px] text-primary px-2 py-1 border border-primary/20 tracking-widest"></span>
    </div>

    <div class="w-12 h-12 bg-surface/80 flex items-center justify-center mb-8 border border-outline-variant/30">
        <span class="material-symbols-outlined font-light text-2xl text-on-surface">{club.icon}</span>
    </div>
    
    <h3 class="font-headline-md text-headline-md text-on-surface mb-4">{club.name}</h3>
    <p class="font-body-md text-body-md text-on-surface-variant mb-8 flex-grow">{club.description}</p>
    
    <div class="flex justify-between items-center mt-auto pt-6 border-t border-outline-variant/30">
        <span class="font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest">{club.category}</span>
        <button @click={`trackClick('${club.id}')`} class="text-on-surface hover:text-primary transition-colors font-meta-label text-meta-label uppercase tracking-widest flex items-center gap-2 group">
            Visit <span class="material-symbols-outlined font-light text-[18px] group-hover:translate-x-2 transition-transform duration-300">arrow_right_alt</span>
        </button>
    </div>
</div>
