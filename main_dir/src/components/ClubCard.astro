---
const { club, index } = Astro.props;
---
<div class={`group stagger-${(index % 2) + 1} stagger-lg-${(index % 3) + 1} bg-white/80 backdrop-blur-sm p-10 diffusion-shadow diffusion-shadow-hover transition-all duration-500 flex flex-col h-[420px] relative animate-fade-up opacity-0 border border-outline-variant/20 overflow-hidden`}
     style={`animation-delay: ${index * 150}ms; animation-fill-mode: forwards;`}>
    
    <!-- Smooth Ambient Lighting -->
    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full blur-[80px] opacity-20 transition-all duration-700 group-hover:opacity-50 group-hover:scale-110 pointer-events-none"
         style={`background-color: ${club.card_color || 'transparent'};`}></div>

    <!-- Admin Clicks Badge -->
    <div x-cloak x-show={`isAdmin && clicks['${club.id}'] > 0`} class="absolute top-6 right-6 z-20">
        <span x-text={`clicks['${club.id}'] + ' CLICKS'`} class="font-meta-label text-[10px] text-primary px-2 py-1 border border-primary/20 tracking-widest bg-white/50 backdrop-blur-md"></span>
    </div>

    <!-- Card Content (z-10 keeps it above the light glow) -->
    <div class="relative z-10 flex flex-col h-full pointer-events-none">
        <div class="w-12 h-12 bg-surface/80 flex items-center justify-center mb-8 border border-outline-variant/30 transition-colors duration-500"
             style={`border-color: ${club.card_color ? club.card_color + '40' : ''};`}>
            <!-- Added a slight tint to the icon to match the glow -->
            <span class="material-symbols-outlined font-light text-2xl text-on-surface"
                  style={`color: ${club.card_color || 'inherit'};`}>
                {club.icon}
            </span>
        </div>
        
        <h3 class="font-headline-md text-headline-md text-on-surface mb-4">{club.name}</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-8 flex-grow">{club.description}</p>
        
        <div class="flex justify-between items-center mt-auto pt-6 border-t border-outline-variant/30 pointer-events-auto">
            <span class="font-meta-label text-meta-label text-on-surface-variant uppercase tracking-widest">{club.category}</span>
            
            <a href={club.link || '#'} target="_blank" rel="noopener noreferrer" @click={`trackClick('${club.id}')`} class="text-on-surface transition-colors font-meta-label text-meta-label uppercase tracking-widest flex items-center gap-2 group/link cursor-pointer hover:opacity-70">
                Visit <span class="material-symbols-outlined font-light text-[18px] group-hover/link:translate-x-2 transition-transform duration-300">arrow_right_alt</span>
            </a>
        </div>
    </div>
</div>
