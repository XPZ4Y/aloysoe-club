---
---
<header class="bg-surface/70 backdrop-blur-md sticky top-0 full-width border-b border-outline-variant/30 z-50">
    <div class="flex justify-between items-center w-full px-gutter max-w-container_max_width mx-auto h-20">
        <div class="flex items-center gap-4">
            <span id="brand-logo" @click="handleLogoClick()" class="font-display-lg text-2xl text-on-surface tracking-tight select-none hover:text-primary transition-colors cursor-pointer">Aloysius Clubs</span>
            <span x-cloak x-show="isAdmin" class="bg-primary text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider ml-2">Admin</span>
        </div>
        
        <nav class="hidden md:flex gap-8 items-center font-meta-label text-meta-label uppercase tracking-widest">
            <a href="#" class="text-primary border-b border-primary pb-1">Directory</a>
            <a href="#" class="text-on-surface-variant hover:text-on-surface transition-colors duration-300">Events</a>
            <a href="#" class="text-on-surface-variant hover:text-on-surface transition-colors duration-300">Archive</a>
            <a href="#" class="text-on-surface-variant hover:text-on-surface transition-colors duration-300">Portal</a>
            <a href="#" x-cloak x-show="isAdmin" @click.prevent="document.getElementById('analytics-section').scrollIntoView({behavior: 'smooth'})" class="text-primary hover:text-primary/80 transition-colors duration-300">Analytics</a>
        </nav>

        <div class="flex items-center gap-6 text-on-surface">
            <button x-cloak x-show="isAdmin" @click="showAddClubModal = true" class="bg-primary text-white font-meta-label text-[11px] px-4 py-2 hover:bg-primary/90 transition-all duration-300 uppercase tracking-widest">
                + Add Club
            </button>
            <button class="hover:text-primary transition-colors duration-300 flex items-center justify-center">
                <span class="material-symbols-outlined font-light">terminal</span>
            </button>
            <button class="hover:text-primary transition-colors duration-300 flex items-center justify-center">
                <span class="material-symbols-outlined font-light">account_circle</span>
            </button>
        </div>
    </div>
</header>
